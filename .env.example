# ParaScout — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais do Supabase

# Obtenha em: supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://XXXXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: chave da Anthropic para análise IA (usada diretamente no cliente — use apenas em dev)
# Em produção, roteie as chamadas de IA por um backend/edge function para proteger a chave
# VITE_ANTHROPIC_API_KEY=sk-ant-...
